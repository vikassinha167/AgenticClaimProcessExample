# Azure AI services endpoint
AZURE_AI_SERVICES_ENDPOINT=https://<your-foundry-instance>.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-openai-deployment-name>

# Azure Language PII detection
AZURE_LANGUAGE_ENDPOINT=https://<your-foundry-instance>.cognitiveservices.azure.com/

# Azure AI Foundry
AZURE_FOUNDRY_ENDPOINT=https://<your-foundry-instance>.services.ai.azure.com/api/projects/<your-foundry-project-id>
AZURE_FOUNDRY_PROJECT_ID=<your-foundry-project-id>
AZURE_FOUNDRY_SCOPE=https://cognitiveservices.azure.com/.default
AZURE_FOUNDRY_AGENT_VERSION=1

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-foundry-instance>.cognitiveservices.azure.com/

# Azure Key Vault access
AZURE_KEY_VAULT_URL=https://<your-key-vault-name>.vault.azure.net/

# Azure Key Vault secret names for service credentials
AZURE_OPENAI_KEY_SECRET_NAME=AzureOpenAIKey
AZURE_FOUNDRY_KEY_SECRET_NAME=AzureAIFoundryKey
AZURE_DOCUMENT_INTELLIGENCE_KEY_SECRET_NAME=AzureFormRecognizerKey
AZURE_LANGUAGE_KEY_SECRET_NAME=AzureLanguageKey

# External Fraud Scoring API
# For local development, point this to the MCP server HTTP endpoint that exposes the fraud tool:

# For Fast API server running locally, use the following URL:
# FRAUD_API_URL=http://127.0.0.1:8000/fraud-score

# For MCP server running locally, use the following URL:
FRAUD_API_URL=http://127.0.0.1:8000/mcp
FRAUD_API_KEY=

# Local MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=development
